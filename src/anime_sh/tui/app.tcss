Screen {
    background: $surface;
}

#search {
    margin: 1 2 0 2;
    border: tall $primary;
}

#body {
    padding: 0 2;
    width: 1fr;
}

/* Region C — the context rail. Width is set from the screen width in
   `_size_rail` rather than here, because the boundary it depends on (120
   columns) is not something CSS can ask about. A single-line left border is the
   whole separation: this is elevation level 1, a panel beside the content, not
   a window floating over it, so it gets no box and no shadow. */
#rail {
    width: 34;
    padding: 0 2;
    border-left: solid $panel;
}

/* The rail is the thing you glance at, so it never competes with the rows for
   attention: its heading uses the same accent as the others but the body stays
   dim, and the whole region is a step back from the content beside it. */
#rail-body {
    color: $text-muted;
}

/* More space above a heading than below it, so a section reads as a lid on the
   rows beneath rather than as a line floating between two lists. The rows
   themselves stay tight: dense inside a group, generous between groups. */
.section {
    margin: 2 0 0 0;
    padding: 0 1;
    text-style: bold;
    color: $accent;
}

/* Rows cap their text at a readable measure (rows.MEASURE_MAX), so let the list
   stop there too. Left at full width, the selection bar stretched the whole of a
   190-column terminal to highlight text occupying half of it. */
ListView {
    background: $surface;
    height: auto;
    max-height: 20;
    max-width: 100;
}

ListView > ListItem {
    padding: 0 1;
}

/* Rows are a grid: each one is exactly one line, and its cells are padded to
   fixed widths in rows.py. Pinning the height here means a title long enough to
   defeat the truncation still cannot wrap and shunt every row below it out of
   alignment. */
AnimeItem {
    height: 1;
}

AnimeItem Label {
    height: 1;
    width: 1fr;
}

/* The class is `-highlight`, one dash. Textual applies `-highlight`; this file
   said `--highlight`, so the selection rule matched nothing and had never
   styled anything — a dead CSS selector raises no error and renders no
   complaint, it just quietly does nothing.

   Which list the keyboard is actually driving has to be visible. Every list
   keeps a highlighted row so you do not lose your place when moving between
   sections, but only the focused one gets the full-strength bar and the accent
   bar down its left edge — the unfocused ones fade to a hint. Colour is not
   carrying this alone: the left border is a shape, so the distinction survives
   a monochrome terminal. */
ListView > ListItem.-highlight {
    background: $primary 15%;
}

ListView:focus > ListItem.-highlight {
    background: $primary 45%;
    border-left: thick $accent;
}

#detail-meta {
    padding: 1 2;
    margin: 1 0;
    border: round $primary;
}

#episodes {
    padding: 0 2;
    max-height: 24;
}
