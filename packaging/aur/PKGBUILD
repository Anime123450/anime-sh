# Maintainer: Animesh Sharma <103582549+Anime123450@users.noreply.github.com>
#
# Generated by scripts/aur_pkgbuild.py - regenerate after each release rather
# than editing the version and checksum by hand.

pkgname=anime-sh
pkgver=0.2.83
pkgrel=1
pkgdesc="Watch anime from your terminal - finds a source, picks a working mirror, plays it in mpv"
arch=('any')
url="https://github.com/Anime123450/anime-sh"
license=('MIT')
# mpv is what actually plays the video, so it is a hard dependency.
# The rest are all packaged in [extra] or [community], which is why this is a
# plain PKGBUILD rather than a vendored virtualenv.
# Note the underscore in python-curl_cffi - that is genuinely what Arch calls
# it, and the hyphenated spelling exists in neither the repos nor the AUR.
depends=(
  'python'
  'python-aiosqlite'
  'python-curl_cffi'
  'python-httpx'
  'python-platformdirs'
  'python-pydantic'
  'python-pydantic-settings'
  'python-rich'
  'python-typer'
  'mpv'
)
# Everything the `tui` extra installs is optional at runtime: `anime --version`
# and every one-shot command work without it, which is exactly how people lose
# the TUI by accident, so it is spelled out rather than assumed.
optdepends=(
  'ffmpeg: for `anime download` and `anime prefetch`'
  'python-textual: the full-screen TUI (plain `anime`)'
  'python-pillow: cover art in the TUI'
  'python-textual-image: sharper cover art on Sixel/kitty terminals (AUR)'
)
makedepends=('python-build' 'python-installer' 'python-uv-build')
source=("https://files.pythonhosted.org/packages/source/a/anime-sh/anime_sh-$pkgver.tar.gz")
sha256sums=('1afe3257b838f71c30d6dcac18afc60b0ca0b902cecd011a0b9323a190bef601')

build() {
  cd "anime_sh-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "anime_sh-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
